# Copy to .env in the project directory; Settings loads it automatically.
# MCP host environment variables take precedence, including empty values.
# JSON array of API tokens, for example: ["first_token", "second_token", "third_token"]
TELEGRAM_ADS_TOKENS=[]
# Optional JSON array of unique names, in the same order as the tokens.
# Without names, use "1", "2", "3", etc. as the profile in tool calls.
# TELEGRAM_ADS_TOKEN_NAMES=["personal", "agency", "test"]
# Optional related-account default when only one token is configured.
# TELEGRAM_ADS_ACCOUNT_ID=your_related_account_id
